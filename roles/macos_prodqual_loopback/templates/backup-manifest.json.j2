{
  "schema_version": "noesis.prodqual.backup_manifest/v1",
  "content_addressed": true,
  "algorithm": "SHA-256",
  "worker_denied": true,
  "backup_root": "{{ prodqual_backup_root }}",
  "never_overwrite_unrecognized": true,
  "hash_note": "Per-file SHA-256 is computed from source bytes at backup_execute; never reuse runtime_payload_digest.",
  "entries": [
    {
      "class": "manifest",
      "source_path": "{{ prodqual_manifest_path }}",
      "destination_path": "{{ prodqual_backup_root }}/payload/approved-release-manifest.json",
      "source_sha256": null,
      "hash_source": "file_bytes_at_backup_execute",
      "owner": "{{ prodqual_authority_user }}",
      "group": "{{ prodqual_authority_group }}",
      "mode": "{{ prodqual_manifest_mode }}",
      "flags": "",
      "recognized": true
    },
    {
      "class": "payload",
      "source_path": "{{ prodqual_runtime_root }}",
      "destination_path": "{{ prodqual_backup_root }}/payload/runtime",
      "source_sha256": null,
      "hash_source": "explicit_file_manifest_at_backup_execute",
      "owner": "{{ prodqual_authority_user }}",
      "group": "{{ prodqual_authority_group }}",
      "mode": "{{ prodqual_runtime_dir_mode }}",
      "flags": "{{ 'uchg' if prodqual_runtime_immutable | bool else '' }}",
      "recognized": true
    },
    {
      "class": "plist",
      "source_path": "{{ prodqual_authority_launchd_dir }}/ai.noesis.broker.plist",
      "destination_path": "{{ prodqual_backup_root }}/plists/ai.noesis.broker.plist",
      "source_sha256": null,
      "hash_source": "file_bytes_at_backup_execute",
      "owner": "{{ prodqual_launchd_plist_owner }}",
      "group": "{{ prodqual_launchd_plist_group }}",
      "mode": "{{ prodqual_launchd_plist_mode }}",
      "flags": "",
      "recognized": true
    },
    {
      "class": "plist",
      "source_path": "{{ prodqual_authority_launchd_dir }}/ai.noesis.orchestrator.plist",
      "destination_path": "{{ prodqual_backup_root }}/plists/ai.noesis.orchestrator.plist",
      "source_sha256": null,
      "hash_source": "file_bytes_at_backup_execute",
      "owner": "{{ prodqual_launchd_plist_owner }}",
      "group": "{{ prodqual_launchd_plist_group }}",
      "mode": "{{ prodqual_launchd_plist_mode }}",
      "flags": "",
      "recognized": true
    },
    {
      "class": "plist",
      "source_path": "{{ prodqual_authority_launchd_dir }}/ai.hermes.gateway.plist",
      "destination_path": "{{ prodqual_backup_root }}/plists/ai.hermes.gateway.plist",
      "source_sha256": null,
      "hash_source": "file_bytes_at_backup_execute",
      "owner": "{{ prodqual_launchd_plist_owner }}",
      "group": "{{ prodqual_launchd_plist_group }}",
      "mode": "{{ prodqual_launchd_plist_mode }}",
      "flags": "",
      "recognized": true
    },
    {
      "class": "plist",
      "source_path": "{{ prodqual_worker_launchd_dir }}/ai.openclaw.gateway.plist",
      "destination_path": "{{ prodqual_backup_root }}/plists/ai.openclaw.gateway.plist",
      "source_sha256": null,
      "hash_source": "file_bytes_at_backup_execute",
      "owner": "{{ prodqual_launchd_plist_owner }}",
      "group": "{{ prodqual_launchd_plist_group }}",
      "mode": "{{ prodqual_launchd_plist_mode }}",
      "flags": "",
      "recognized": true
    }
  ],
  "service_state": [
{% for label in prodqual_service_labels %}
    {
      "label": "{{ label }}",
      "loaded": false,
      "pid": null,
      "phase": "recorded_at_backup_execute"
    }{% if not loop.last %},{% endif %}

{% endfor %}
  ]
}
